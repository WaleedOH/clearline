# Copy this file to .env and paste your Meta Model API key after the = sign.
# .env is ignored by git, so the key never reaches GitHub.
MODEL_API_KEY=

# Safety cap: the most SAM 3.1 calls the app will make before stopping (each costs $0.0025).
# 400 calls is about $1. Raise it once you're comfortable.
SAM_CALL_LIMIT=400
