# Copy this file to .env and paste your Meta Model API key after the = sign.
# .env is ignored by git, so the key never reaches GitHub.
MODEL_API_KEY=

# Safety cap: the app stops calling Meta's models once its estimated spend this run reaches
# this many US dollars. One SAM 3.1 call is $0.0025; a Muse Spark check is around $0.001-0.003.
SPEND_LIMIT_USD=2
